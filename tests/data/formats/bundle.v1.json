{
  "fsd_bundle_version": 1,
  "adapter": "golden_adapter:GoldenAdapter",
  "artifacts": {
    "model": "model.bin"
  },
  "feature": {
    "kind": "callable",
    "steps": [
      "<adapter.features>"
    ]
  },
  "requirements": [
    "scikit-learn>=1.3"
  ],
  "required_bands": [
    "B04",
    "B08"
  ],
  "n_timestamps": 3,
  "output_dtype": "uint8",
  "output_nodata": 255,
  "output_band_names": [
    "klass"
  ]
}
